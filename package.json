{
  "name": "vietnam-weather-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Intelligent Weather-Aware Travel Assistant for Vietnam",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run build && pnpm -r --if-present test",
    "test:mail": "node tools/test-mailer.mjs",
    "validate:stage1": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage1.ps1",
    "validate:stage2": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage2.ps1",
    "validate:stage2:remote": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage2-remote.ps1",
    "validate:stage3": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage3.ps1",
    "validate:stage4": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage4.ps1",
    "validate:stage5": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage5.ps1",
    "validate:stage6": "powershell -ExecutionPolicy Bypass -File tools/validation/validate-stage6.ps1",
    "inspect:directus-license": "powershell -ExecutionPolicy Bypass -File tools/directus/validate-license.ps1",
    "validate:directus-license": "powershell -ExecutionPolicy Bypass -File tools/directus/validate-license.ps1 -RequireLicensed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0"
  }
}
